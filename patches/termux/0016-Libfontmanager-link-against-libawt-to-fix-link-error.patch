From 244e732a47c8f77eeb3e4f08d8e1965739245980 Mon Sep 17 00:00:00 2001
From: Duy Tran Khanh <40482367+khanhduytran0@users.noreply.github.com>
Date: Sat, 12 Jun 2021 17:03:05 +0700
Subject: [PATCH 16/40] Libfontmanager: link against libawt to fix link error

Partly based on commit from androidports:
https://github.com/androidports/openjdk/commit/a3e4f0281154537f01c2e59286a6ceed9c827b11

[NLauncher] Modified: the original unconditionally links libfontmanager
against libawt_xawt. Our build is --enable-headless-only, where libawt_xawt
does not exist, so on Linux/Android targets we link against libawt_headless
when building headless-only and against libawt_xawt otherwise. The extra
libraries are added via LIBS_linux so a macOS-hosted build JDK is unaffected.
---
 make/modules/java.desktop/lib/Awt2dLibraries.gmk | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/make/modules/java.desktop/lib/Awt2dLibraries.gmk b/make/modules/java.desktop/lib/Awt2dLibraries.gmk
--- a/make/modules/java.desktop/lib/Awt2dLibraries.gmk
+++ b/make/modules/java.desktop/lib/Awt2dLibraries.gmk
@@ -541,6 +541,19 @@
 
 LIBFONTMANAGER_CFLAGS += $(X_CFLAGS) -DLE_STANDALONE -DHEADLESS
 
+# libfontmanager references symbols that live in the toolkit library
+# (libawt_xawt or libawt_headless). On Linux/Android link against it
+# explicitly, otherwise the library fails to link/load on Android.
+ifeq ($(call isTargetOs, linux), true)
+  ifeq ($(ENABLE_HEADLESS_ONLY), true)
+    LIBFONTMANAGER_AWT_IMPL := -lawt_headless
+    LIBFONTMANAGER_AWT_IMPL_DEP := $(BUILD_LIBAWT_HEADLESS)
+  else
+    LIBFONTMANAGER_AWT_IMPL := -lawt_xawt
+    LIBFONTMANAGER_AWT_IMPL_DEP := $(BUILD_LIBAWT_XAWT)
+  endif
+endif
+
 # LDFLAGS clarification:
 #   Filter relevant linker flags disallowing unresolved symbols as we cannot
 #   build-time decide to which library to link against (libawt_headless or
@@ -568,12 +581,13 @@
     LDFLAGS_aix := -Wl$(COMMA)-berok, \
     LIBS := $(BUILD_LIBFONTMANAGER_FONTLIB), \
     LIBS_unix := -lawt -ljava -ljvm $(LIBM) $(LIBCXX), \
+    LIBS_linux := $(LIBFONTMANAGER_AWT_IMPL) -lc, \
     LIBS_macosx := -lawt_lwawt -framework CoreText -framework CoreFoundation -framework CoreGraphics, \
     LIBS_windows := $(WIN_JAVA_LIB) advapi32.lib user32.lib gdi32.lib \
         $(WIN_AWT_LIB), \
 ))
 
-$(BUILD_LIBFONTMANAGER): $(BUILD_LIBAWT)
+$(BUILD_LIBFONTMANAGER): $(BUILD_LIBAWT) $(LIBFONTMANAGER_AWT_IMPL_DEP)
 
 ifeq ($(call isTargetOs, macosx), true)
   $(BUILD_LIBFONTMANAGER): $(call FindLib, $(MODULE), awt_lwawt)
